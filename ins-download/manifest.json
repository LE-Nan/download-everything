{
  "manifest_version": 3,
  "name": "ins download",
  "version": "1.3.0",
  "description": "在 Instagram 与微博网页端的图片/视频动态旁显示下载按钮，一键按设置静默下载，支持轮播全量与打包 zip。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "*://*.weibo.com/*",
    "*://*.weibo.cn/*",
    "*://*.sinaimg.cn/*",
    "*://*.weibocdn.com/*",
    "*://*.weibocdn.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.weibo.com/*"],
      "js": ["weibo.js"],
      "css": ["weibo.css"],
      "run_at": "document_idle"
    }
  ]
}
